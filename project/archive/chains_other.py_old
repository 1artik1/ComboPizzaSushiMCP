# -*- coding: utf-8 -*-
"""chains_other.py — parsers for pizza/sushi delivery chains (other than la_pizza)."""

import re
import json
import requests
from bs4 import BeautifulSoup

HEADERS = {
    "User-Agent": (
        "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
        "AppleWebKit/537.36 (KHTML, like Gecko) "
        "Chrome/120.0.0.0 Safari/537.36"
    ),
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
}


def _fetch(url, timeout=5):
    import socket as _socket
    import requests as _requests
    try:
        _socket.setdefaulttimeout(timeout)
        r = _requests.get(url, headers=HEADERS, timeout=timeout, verify=False, allow_redirects=True)
        if r.status_code == 200:
            return r.text
    except (_requests.exceptions.Timeout, _requests.exceptions.ConnectionError, OSError, Exception):
        pass
    finally:
        _socket.setdefaulttimeout(None)
    return None


def _clean(text):
    if text is None:
        return ""
    return re.sub(r'\s+', ' ', text).strip()


# ============================================================================
# pizza_kuba
# ============================================================================

def _parse_pizza_kuba(html):
    """Parse pizzeriacuba.ru — fully JS-rendered; extract from inline data if available."""
    products = []
    soup = BeautifulSoup(html, 'html.parser')

    # Try to find product data in JS variables or JSON
    scripts = soup.find_all('script')
    for script in scripts:
        text = script.string or ''
        # Look for product arrays
        for m in re.finditer(r'\{[^{}]*"name"[^{}]*"price"[^{}]*\}', text, re.DOTALL):
            try:
                d = json.loads(m.group())
                name = d.get('name', '')
                price = d.get('price', 0)
                if isinstance(price, str):
                    price = int(re.search(r'(\d+)', price).group(1))
                elif isinstance(price, (int, float)):
                    price = int(price)
                if name and price > 0:
                    products.append({
                        "name": name,
                        "weight_g": None,
                        "price_rub": price,
                        "is_from_price": False,
                        "description": name,
                        "category": "Пицца",
                        "product_url": "https://pizzeriacuba.ru/",
                    })
            except (json.JSONDecodeError, ValueError):
                pass

    # Also try to find menu items from navigation categories + price patterns
    # Look for category headings and items below them
    categories = []
    for h in soup.find_all(['h2', 'h3', 'h4']):
        cat = _clean(h.get_text())
        if cat and len(cat) > 3 and len(cat) < 50:
            categories.append(cat)

    # Find all price patterns in the HTML and extract surrounding text
    # The site may have prices embedded in specific elements
    for el in soup.find_all(['span', 'div', 'li', 'p']):
        text = el.get_text()
        price_m = re.search(r'(\d+)\s*[₽\u20bd]', text)
        name_m = re.search(r'([А-Яа-яA-Za-z\s]{5,60})', text)
        if price_m and name_m:
            price = int(price_m.group(1))
            name = _clean(name_m.group(1))
            if name and price > 50 and len(name) > 3:
                products.append({
                    "name": name,
                    "weight_g": None,
                    "price_rub": price,
                    "is_from_price": 'от' in text[:50],
                    "description": name,
                    "category": "Пицца",
                    "product_url": "https://pizzeriacuba.ru/",
                })

    # Deduplicate
    seen = set()
    unique = []
    for p in products:
        key = (p["name"].lower(), p["price_rub"])
        if key not in seen:
            seen.add(key)
            unique.append(p)
    return unique


def parse_pizza_kuba():
    """Pizza Kubа — Nuxt.js SPA, API requires JS execution. Unavailable via simple HTTP."""
    return []


