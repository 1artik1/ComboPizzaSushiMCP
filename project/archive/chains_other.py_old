# ============================================================================
# sushi_darom (Next.js with __NEXT_DATA__)
# ============================================================================

def _parse_sushi_darom(html):
    """Parse voronezh.sushi-darom.com — Next.js site with __NEXT_DATA__ JSON.
    
    Each offer has:
      - name: product name (UTF-8)
      - price: price in rubles (int)
      - parametr.outQuantity_raw: weight in grams (string like "255")
      - categoryId: category ID matching categories[].id
      - structure: ingredient description
    """
    products = []

    # Find __NEXT_DATA__ JSON
    next_data = re.findall(r'<script id="__NEXT_DATA__"[^>]*>(.*?)</script>', html, re.DOTALL)
    if next_data:
        try:
            data = json.loads(next_data[0])
            props = data.get('props', {})
            page_props = props.get('pageProps', {})

            # Build category mapping: id -> name
            categories = page_props.get('categories', [])
            cat_map = {}
            if isinstance(categories, list):
                for cat in categories:
                    if isinstance(cat, dict):
                        cat_id = str(cat.get('id', ''))
                        cat_name = cat.get('category', '')
                        if cat_id and cat_name:
                            cat_map[cat_id] = cat_name

            # Products are in 'offers' list
            offers = page_props.get('offers', [])
            if isinstance(offers, list):
                for item in offers:
                    if not isinstance(item, dict):
                        continue
                    name = item.get('name', '')
                    price = item.get('price', 0)
                    if isinstance(price, str):
                        price = int(re.search(r'(\d+)', price).group(1))
                    elif isinstance(price, (int, float)):
                        price = int(price)

                    if name and price > 0:
                        # Extract weight from parametr.outQuantity_raw
                        weight = None
                        param = item.get('parametr', {})
                        if isinstance(param, dict):
                            out_raw = param.get('outQuantity_raw', '')
                            if out_raw:
                                try:
                                    weight = int(out_raw)
                                except (ValueError, TypeError):
                                    pass

                        category = cat_map.get(str(item.get('categoryId', '')), 'Роллы/Суши')
                        desc = item.get('structure', '') or item.get('description', '')
                        if not desc:
                            desc = name
                        products.append({
                            "name": name,
                            "weight_g": weight,
                            "price_rub": price,
                            "is_from_price": False,
                            "description": desc,
                            "category": category,
                            "product_url": "https://voronezh.sushi-darom.com/",
                        })
        except (json.JSONDecodeError, KeyError, IndexError):
            pass

    return products


def parse_sushi_darom():
    """Sushi Darom — Next.js SPA, 170 items with REAL weights from parametr.outQuantity_raw."""
    html = _fetch("https://voronezh.sushi-darom.com/")
    if html is None:
        return []
    return _parse_sushi_darom(html)


# ============================================================================
# anti_sushi (BeautifulSoup-based)
# ============================================================================

def _parse_anti_sushi(html):
    """Parse anti-sushi.ru — products with schema.org markup."""
    products = []
    soup = BeautifulSoup(html, 'html.parser')

    # Find all product divs
    product_divs = soup.find_all('div', class_='product')
    for pd in product_divs[:100]:
        # Find price from itemprop="price" meta
        price_meta = pd.find('meta', itemprop='price')
        if not price_meta:
            continue
        try:
            price = int(price_meta['content'])
        except (ValueError, KeyError):
            continue

        if price <= 0:
            continue

        # Find name from itemprop="name" meta
        name_meta = pd.find('meta', itemprop='name')
        if not name_meta:
            continue
        name = _clean(name_meta['content'])
        if not name or len(name) < 3:
            continue

        # Find weight from class="weight" span
        weight = None
        weight_span = pd.find('span', class_='weight')
        if weight_span:
            wt_text = _clean(weight_span.get_text())
            wt_num = re.search(r'(\d+)', wt_text)
            if wt_num:
                weight = int(wt_num.group(1))

        # Find description from class="product-description"
        desc_div = pd.find('div', class_='product-description')
        description = _clean(desc_div.get_text()) if desc_div else name

        # Find category from href
        href = pd.find('a', class_='product-title')
        category = "Роллы/Суши"
        href_url = ""
        if href and href.get('href'):
            href_url = href['href']
            cat_url = href_url.lower()
            if 'sets' in cat_url or 'сеты' in cat_url:
                category = "Сеты"
            elif 'rolls' in cat_url or 'ролл' in cat_url:
                category = "Роллы"
            elif 'sushi' in cat_url or 'суши' in cat_url:
                category = "Суши"
            elif 'pizza' in cat_url or 'пицца' in cat_url:
                category = "Пицца"
            elif 'lapsha' in cat_url or 'лапша' in cat_url:
                category = "Горячее"
            elif 'zakuski' in cat_url or 'закус' in cat_url:
                category = "Закуски"

        products.append({
            "name": name,
            "weight_g": weight,
            "price_rub": price,
            "is_from_price": False,
            "description": description,
            "category": category,
            "product_url": f"https://anti-sushi.ru/{href_url}" if href_url else "https://anti-sushi.ru/",
        })

    return products


def parse_anti_sushi():
    html = _fetch("https://anti-sushi.ru/")
    if html is None:
        return []
    return _parse_anti_sushi(html)


# ============================================================================
# dodo (Dodo Pizza) — API blocked by captcha
# ============================================================================

def parse_dodo():
    """Dodo Pizza — API blocked by captcha/cors. Unavailable via simple HTTP."""
    return []


def _extract_dodo_products(data):
    products = []
    if isinstance(data, dict):
        for key in ['products', 'items', 'menu', 'data']:
            if key in data:
                val = data[key]
                if isinstance(val, list):
                    for item in val[:100]:
                        if isinstance(item, dict):
                            name = item.get('name', '')
                            price = item.get('price', 0)
                            if isinstance(price, dict):
                                price = price.get('value', 0)
                            if isinstance(price, (int, float)):
                                price = int(price)
                            if name and price > 0:
                                products.append({
                                    "name": name,
                                    "weight_g": None,
                                    "price_rub": price,
                                    "is_from_price": False,
                                    "description": item.get('description', name),
                                    "category": item.get('category', 'Пицца'),
                                    "product_url": "https://dodopizza.ru/",
                                })
                elif isinstance(val, dict):
                    for k2, v2 in val.items():
                        if isinstance(v2, list):
                            for item in v2[:100]:
                                if isinstance(item, dict):
                                    name = item.get('name', '')
                                    price = item.get('price', 0)
                                    if isinstance(price, dict):
                                        price = price.get('value', 0)
                                    if isinstance(price, (int, float)):
                                        price = int(price)
                                    if name and price > 0:
                                        products.append({
                                            "name": name,
                                            "weight_g": None,
                                            "price_rub": price,
                                            "is_from_price": False,
                                            "description": item.get('description', name),
                                            "category": item.get('category', 'Пицца'),
                                            "product_url": "https://dodopizza.ru/",
                                        })
                break
    return products


# ============================================================================
# Chain registry
# ============================================================================

CHAIN_PARSERS = {
    "la_pizza": None,  # handled by chains_la_pizza
    "pizza_kuba": parse_pizza_kuba,
    "san_remo": parse_san_remo,
    "ninja_food": parse_ninja_food,
    "sushi_time": parse_sushi_time,
    "sushi_darom": parse_sushi_darom,
    "anti_sushi": parse_anti_sushi,
    "dodo": parse_dodo,
}


def parse_menu(chain_id):
    """Parse menu for a given chain ID."""
    if chain_id == "la_pizza":
        import chains_la_pizza
        return chains_la_pizza.parse_menu(chain_id)
    parser = CHAIN_PARSERS.get(chain_id)
    if parser is None:
        raise ValueError(f"Unknown chain: {chain_id}")
    return parser()
