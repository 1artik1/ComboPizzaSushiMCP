# ============================================================================
# ninja_food
# ============================================================================

def _parse_ninja_food(html):
    """Parse ninjafood.su — Bitrix-based site."""
    products = []
    soup = BeautifulSoup(html, 'html.parser')

    # Find categories from H-tags
    category = "Пицца"
    for h in soup.find_all(['h1', 'h2', 'h3']):
        cat_text = _clean(h.get_text())
        if cat_text:
            if 'Пицца' in cat_text:
                category = "Пицца"
            elif 'Ролл' in cat_text:
                category = "Роллы"
            elif 'Сет' in cat_text:
                category = "Сеты"
            elif 'Ланч' in cat_text:
                category = "Ланчи"
            elif 'Набор' in cat_text:
                category = "Наборы"
            elif 'Вок' in cat_text:
                category = "Вок"
            elif 'Салат' in cat_text:
                category = "Салаты"
            elif 'Суп' in cat_text:
                category = "Супы"

    # Find all elements with price text
    for el in soup.find_all(['span', 'div', 'li', 'p']):
        text = el.get_text()
        price_m = re.search(r'(\d+)\s*[₽\u20bd]', text)
        name_m = re.search(r'([А-Яа-яA-Za-z\s]{5,60})', text)
        if price_m and name_m:
            price = int(price_m.group(1))
            name = _clean(name_m.group(1))
            if name and price > 50 and len(name) > 3:
                products.append({
                    "name": name,
                    "weight_g": None,
                    "price_rub": price,
                    "is_from_price": 'от' in text[:50],
                    "description": text[:200],
                    "category": category,
                    "product_url": "https://ninjafood.su/",
                })

    # Deduplicate
    seen = set()
    unique = []
    for p in products:
        key = (p["name"].lower(), p["price_rub"])
        if key not in seen:
            seen.add(key)
            unique.append(p)
    return unique


def parse_ninja_food():
    """Ninja Food — Bitrix SPA, product data rendered via JS. No weights or names via simple HTTP."""
    return []


