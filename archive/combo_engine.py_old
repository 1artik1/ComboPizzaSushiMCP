"""combo_engine.py — functions reused from la_pizza_app.py (adapted).

Reused: count_ingredients, solve_max_weight_single, solve_max_weight_double,
        solve_optimum, _solve_optimum_pareto, _pareto_filter, _pareto_dominates,
        format_combo, calculate_combos.
"""

from collections import Counter

